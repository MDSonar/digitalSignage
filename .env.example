# Litmus Digital Signage - Environment Variables Example
# Copy this file to .env and customize as needed

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0

# Port Configuration
DASHBOARD_PORT=5000
WEB_PLAYER_PORT=8080

# Security (Change in production!)
SECRET_KEY=change-this-secret-key-in-production-12345

# Admin Credentials (Change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=signage

# File Upload Limits
MAX_CONTENT_LENGTH=2147483648  # 2GB in bytes

# Application Settings
SLIDE_DURATION=10
CHECK_INTERVAL=20

# Database (if you add database support later)
# DATABASE_URL=postgresql://user:pass@localhost/signage
